# .dockerignore
# Files and directories to exclude from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
*.md
docs/

# Logs
logs/
*.log

# Test files
tests/
*_test.py
test_*.py

# Data directories (exclude large files)
data/raw/
data/processed/
data/models/
data/pdf_cache/
project_data/

# Node.js (for frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/

# Monitoring
monitoring/grafana/data/
prometheus_data/

# Temporary files
tmp/
temp/
*.tmp